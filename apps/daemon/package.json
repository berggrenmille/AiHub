{
  "name": "@aihub/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "start": "tsx --disable-warning=ExperimentalWarning src/index.ts",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --disable-warning=ExperimentalWarning --test --test-reporter=spec \"src/**/*.test.ts\"",
    "measure:briefing": "tsx --disable-warning=ExperimentalWarning scripts/measure-briefing.ts",
    "probe:failures": "tsx --disable-warning=ExperimentalWarning scripts/probe-failures.ts"
  },
  "dependencies": {
    "@aihub/codex-protocol": "*",
    "@aihub/shared": "*",
    "@fastify/static": "^10.1.10",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "fastify": "^5.12.8",
    "ical.js": "^2.2.1",
    "quickjs-emscripten-core": "0.32.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
